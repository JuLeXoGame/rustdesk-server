# Clé publique d'autorisation réseau (jamais la clé privée de l'API).
RELAISDESK_AUTH_REQUIRED=Y
RELAISDESK_AUTH_PUBLIC_KEYS=relaisdesk-1=<cle-publique-base64url>

# URL publique du code source correspondant exactement à l'image déployée.
SERVER_SOURCE_URL=https://github.com/<compte-github>/rustdesk-server/tree/relaisdesk/authorization
