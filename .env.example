# Clé publique d'autorisation réseau (jamais la clé privée de l'API).
RELAISDESK_AUTH_REQUIRED=Y
RELAISDESK_AUTH_PUBLIC_KEYS=relaisdesk-1=<cle-publique-base64url>

# Exemple de branche publique. En production, remplacer cette URL par le commit
# immuable qui a réellement produit l'image déployée.
SERVER_SOURCE_URL=https://github.com/JuLeXoGame/rustdesk-server/tree/relaisdesk/authorization
